<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Product>XIVLauncher.Common.Linux</Product>
        <AssemblyTitle>XIVLauncher.Common.Linux</AssemblyTitle>
        <Description>Linux platform implementations for XIVLauncher.Core: Proton/umu-launcher game launching and in-prefix Windows Dalamud injection.</Description>
        <VersionPrefix>0.1.0</VersionPrefix>
        <Nullable>enable</Nullable>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Deterministic>true</Deterministic>
        <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\lib\FFXIVQuickLauncher\src\XIVLauncher.Common\XIVLauncher.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <PackageReference Include="Serilog" Version="4.2.0" />
        <PackageReference Include="Tomlyn" Version="2.10.1" />
        <!-- Steamworks binding for Steam-account login (Facepunch.Steamworks, chippy branch:
             the Win64-named assembly P/Invokes "steam_api64", which loads libsteam_api64.so
             from the app dir on Linux; the native .so ships as app content). -->
        <PackageReference Include="goaaats.Steamworks" Version="2.3.4" />
    </ItemGroup>

</Project>
