<Window
    x:Class="XIVonLinux.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="960"
    Height="600"
    MinWidth="640"
    MinHeight="400"
    Title="XIVonLinux">
    <DockPanel Margin="20">

        <!-- Left side: one docked column split vertically into the login frame (top,
             fills) and the buttons frame (bottom). Docking the whole column to the left
             keeps the news frame full-height on the right. -->
        <Grid DockPanel.Dock="Left" RowDefinitions="*,Auto" MinWidth="200" Margin="0,0,12,0">
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="4"
                    Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Username" Margin="0,0,0,2" />
                        <TextBox Name="UsernameBox" />
                        <TextBlock Text="Password" Margin="0,8,0,2" />
                        <TextBox Name="PasswordBox" PasswordChar="*" />
                        <CheckBox Content="OTP" Name="OtpCheck" Margin="5,0,5,0" />
                        <CheckBox Content="Steam account" Name="SteamAccountCheck" Margin="5,0,5,0" />
                        <CheckBox Content="Free trial" Name="FreeTrialCheck" Margin="5,0,5,0" />
                        <CheckBox Content="Save password" Name="SavePasswordCheck" Margin="5,0,5,0" />
                        <Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto">
                            <Button Grid.Column="0" Content="Login" Name="LoginButton" Click="OnLogin" Height="40"
                                    VerticalContentAlignment="Center"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <!-- Square caret (caret-down f0d7) opening the Settings/troubleshooting
                                 window, same height as the Login button, docked to its right. -->
                            <Button Grid.Column="1" Name="TroubleshootButton" Click="OnTroubleshoot" Width="40" Height="40"
                                    VerticalContentAlignment="Center"
                                    Margin="8,0,0,0" HorizontalContentAlignment="Center" ToolTip.Tip="Extra Login Actions">
                                <TextBlock FontFamily="avares://XIVonLinux/Resources/fonts/FontAwesome5FreeSolid.otf#Font Awesome 5 Free Solid"
                                           Text="&#xf0d7;" FontSize="20" />
                            </Button>
                        </Grid>
                        <Button Name="AccountsButton" Margin="0,8,0,0" Width="40" Height="40"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Left" HorizontalContentAlignment="Center" ToolTip.Tip="Manage Accounts">
                            <TextBlock FontFamily="avares://XIVonLinux/Resources/fonts/FontAwesome5FreeSolid.otf#Font Awesome 5 Free Solid"
                                       Text="&#xf4fe;" FontSize="18" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Row="1" Margin="0,8,0,0"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="4"
                    Padding="6,8">
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <Button Name="LogToggleButton" Click="OnToggleLog" Padding="12,10" HorizontalContentAlignment="Center" ToolTip.Tip="Show/Hide Log">
                        <TextBlock Name="LogGlyph" FontFamily="avares://XIVonLinux/Resources/fonts/FontAwesome5FreeSolid.otf#Font Awesome 5 Free Solid"
                                   Text="&#xf022;" FontSize="22" />
                    </Button>
                    <Button Name="AccountButton" Click="OnOpenAccount" Padding="12,10" HorizontalContentAlignment="Center" ToolTip.Tip="MogStation Account">
                        <TextBlock FontFamily="avares://XIVonLinux/Resources/fonts/FontAwesome5FreeSolid.otf#Font Awesome 5 Free Solid"
                                   Text="&#xf007;" FontSize="22" />
                    </Button>
                    <Button Name="StatusButton" Click="OnOpenStatus" Padding="12,10" HorizontalContentAlignment="Center" ToolTip.Tip="Is FFXIV Up?">
                        <TextBlock FontFamily="avares://XIVonLinux/Resources/fonts/FontAwesome5FreeSolid.otf#Font Awesome 5 Free Solid"
                                   Text="&#xf0ac;" FontSize="22" />
                    </Button>
                    <Button Name="SettingsButton" Click="OnSettings" Padding="12,10" HorizontalContentAlignment="Center" ToolTip.Tip="Settings">
                        <TextBlock FontFamily="avares://XIVonLinux/Resources/fonts/FontAwesome5FreeSolid.otf#Font Awesome 5 Free Solid"
                                   Text="&#xf013;" FontSize="22" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- News frame fills the remaining width on the right (news shown while the log is
             hidden, log box replaces it when shown); headlines scroll when the frame shrinks. -->
        <Grid MinWidth="180">
            <!-- A. News banner + headlines: visible while the log is hidden -->
            <Border Name="NewsPanel"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <!-- Banner section: fixed slot that shrinks with the column width
                         (max 640x250, left-aligned); it never scrolls -->
                    <StackPanel DockPanel.Dock="Top" Margin="12,0,12,8" Spacing="8">
                        <TextBlock Name="NewsLoadingText" Text="Loading news..." />
                        <Image Name="BannerImage" IsVisible="False" MaxWidth="640" MaxHeight="250"
                               HorizontalAlignment="Left" Stretch="Uniform" />
                    </StackPanel>

                    <!-- Headlines section: scrollbar appears only when headlines overflow -->
                    <ScrollViewer Name="NewsScroll" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Name="NewsList" Margin="12,0,12,12" Spacing="4" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Log box: replaces the news area when shown -->
            <TextBox Name="StatusLog" IsVisible="False"
                     IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" />
        </Grid>
    </DockPanel>
</Window>
