<Window
    x:Class="XIVonLinux.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="900"
    Height="560"
    Title="XIVonLinux">
    <DockPanel Margin="20">

        <!-- Logging area, docked last so it sits BELOW the button bar: hidden by default
             (window has no room for it); Show grows the window, Hide shrinks it back -->
        <TextBox DockPanel.Dock="Bottom" Name="StatusLog" IsVisible="False" Height="0"
                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Margin="0" />

        <!-- Button bar: two left-aligned action buttons, full width -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
            <Button Content="Settings" Name="SettingsButton" Click="OnSettings" />
            <Button Content="Show log" Name="LogToggleButton" Click="OnToggleLog" />
        </StackPanel>

        <!-- Row 0: news (2/3) | login (1/3); row 1: log box spanning the full width -->
        <Grid ColumnDefinitions="2*,*" RowDefinitions="*">

            <!-- A. News banner + headlines -->
            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,12,0"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="4">
                <StackPanel Margin="12">
                    <Border Background="#1B2A3A" CornerRadius="4" Padding="10,8">
                        <TextBlock Text="NEWS BANNER" FontSize="20" FontWeight="Bold" />
                    </Border>
                    <StackPanel Margin="0,10,0,0" Spacing="6">
                        <TextBlock Text="Headline placeholder" FontWeight="Bold" />
                        <TextBlock Text="Headline placeholder" FontWeight="Bold" />
                        <TextBlock Text="Headline placeholder" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- B. Login section -->
            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                <TextBlock Text="Username" Margin="0,0,0,2" />
                <TextBox Name="UsernameBox" />
                <TextBlock Text="Password" Margin="0,8,0,2" />
                <TextBox Name="PasswordBox" PasswordChar="*" />
                <TextBlock Text="OTP" Margin="0,8,0,2" />
                <TextBox Name="OtpBox" />
                <CheckBox Content="Steam account" Name="SteamAccountCheck" Margin="0,12,0,0" />
                <CheckBox Content="Free trial" Name="FreeTrialCheck" Margin="0,2,0,0" />
                <Button Content="Login" Name="LoginButton" Click="OnLogin" Margin="0,12,0,0" />
            </StackPanel>

        </Grid>
    </DockPanel>
</Window>
