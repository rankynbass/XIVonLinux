<Window
    x:Class="XIVonLinux.Settings.SettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="960"
    Height="600"
    MinWidth="640"
    MinHeight="400"
    Title="Settings"
    CanResize="True">
    <DockPanel Margin="20,0,20,20">

        <!-- Save at lower right -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="12"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Name="SaveButton" Click="OnSave" Padding="12,10" HorizontalContentAlignment="Center">
                <TextBlock FontFamily="avares://XIVonLinux/Resources/fonts/FontAwesome5FreeSolid.otf#Font Awesome 5 Free Solid"
                           Text="&#xf058;" FontSize="22" />
            </Button>
        </StackPanel>

        <!-- Tab bar stays fixed at the top; each TabItem's content scrolls on its own
             (per-tab ScrollViewers below), so long tabs never push the tab bar away.
             Horizontal scroll disabled: Auto measures content at infinite width, which
             defeats TextWrapping on the tab labels. -->
        <TabControl>

            <TabItem>
                <TabItem.Header><TextBlock Text="Game" FontSize="14" /></TabItem.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,12,0,0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="GamePath" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <TextBox Grid.Row="0" Grid.Column="1" Name="GamePathBox" Margin="0,0,8,6" />
                    <Button Grid.Row="0" Grid.Column="2" Content="Browse" Name="GameBrowseButton" Click="OnBrowseGame" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Config" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <TextBox Grid.Row="1" Grid.Column="1" Name="ConfigPathBox" Margin="0,0,8,6" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse" Name="ConfigBrowseButton" Click="OnBrowseConfig" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Language" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Name="LanguageCombo" Margin="0,0,0,6" />

                    <!-- XIVLauncher.Core parity: extra key=value game args, DPI awareness,
                         Steam-ignore, XL auth macros, uid cache. -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Args" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Name="AdditionalArgsBox" Margin="0,0,0,6"
                             Watermark="Extra game arguments (key=value pairs)" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="DPI" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Name="DpiCombo" Margin="0,0,0,6" />

                    <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Content="Ignore Steam (never launch via Steam service account)"
                              Name="IgnoreSteamCheck" HorizontalAlignment="Left" Margin="0,0,0,6" />

                    <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Content="Use XL auth macros"
                              Name="XlAuthCheck" HorizontalAlignment="Left" Margin="0,0,0,6" IsVisible="False" />

                    <CheckBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Content="Use UID cache"
                              Name="UidCacheCheck" HorizontalAlignment="Left" Margin="0,0,0,6"
                              IsCheckedChanged="OnUidCacheToggled" />

                    <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="10"
                                Name="UidCachePanel" IsVisible="False" Margin="0,0,0,6">
                        <TextBlock Text="Reset the uid cache; you must then restart the launcher." VerticalAlignment="Center" />
                        <Button Content="Reset UID Cache" Name="ResetUidCacheButton" Click="OnResetUidCache" />
                    </StackPanel>

                    <CheckBox Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" Content="Close XIVonLinux on game launch"
                              Name="CloseOnLaunchCheck" HorizontalAlignment="Left" Margin="0,0,0,6" />
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header><TextBlock Text="Patching" FontSize="14" /></TabItem.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,12,0,0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Patches" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <TextBox Grid.Row="0" Grid.Column="1" Name="PatchPathBox" Margin="0,0,8,6" />
                    <Button Grid.Row="0" Grid.Column="2" Content="Browse" Name="PatchBrowseButton" Click="OnBrowsePatch" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Speed (KiB/s)" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Name="SpeedBox" Margin="0,0,0,6"
                             Watermark="Speed (KiB/s, 0 = unlimited)" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Connections" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Name="ConnectionsBox" Margin="0,0,0,6"
                             Watermark="Max connections per server (1-16)" />
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header><TextBlock Text="Proton" FontSize="14" /></TabItem.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,12,0,0">
                    <!-- Custom = folder pick (Proton row + Browse); managed = pick from the
                         enumerated Proton list (compatibilitytools.d, steamapps/common, tools/proton).
                         Combo occupies the same row as the Proton textbox — swapping in place,
                         so the label stays flush against whichever control is showing. -->
                    <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Content="Managed proton (pick from enumerated list)"
                              Name="ManagedProtonCheck" HorizontalAlignment="Left" Margin="0,0,0,6"
                              IsChecked="False" IsCheckedChanged="OnManagedProtonToggled" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Name="ProtonLabel" Text="Proton (Custom)" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <TextBox Grid.Row="1" Grid.Column="1" Name="ProtonPathBox" Margin="0,0,8,6" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse" Name="ProtonBrowseButton" Click="OnBrowseProton" Margin="0,0,0,6" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Name="ProtonCombo"
                              Margin="0,0,0,6" IsVisible="False" SelectionChanged="OnProtonCombo" />

                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16" Margin="0,0,0,6">
                        <CheckBox Content="Enable DXVK" Name="DxvkCheck" />
                        <CheckBox Content="Enable Wayland" Name="WaylandCheck" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Wine Sync method" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Name="WineSyncCombo" Margin="0,0,0,6" />

                    <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Content="Managed umu launcher (latest/previous GitHub releases)"
                              Name="ManagedUmuCheck" HorizontalAlignment="Left" Margin="0,0,0,6"
                              IsChecked="True" IsCheckedChanged="OnManagedUmuToggled" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Name="UmuLabel" Text="Umu (Custom)" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <TextBox Grid.Row="5" Grid.Column="1" Name="UmuPathBox" Margin="0,0,8,6" />
                    <Button Grid.Row="5" Grid.Column="2" Content="Browse" Name="UmuBrowseButton" Click="OnBrowseUmu" Margin="0,0,0,6" />
                    <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Name="UmuCombo"
                              Margin="0,0,0,6" IsVisible="False" SelectionChanged="OnUmuCombo" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Prefix" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <TextBox Grid.Row="6" Grid.Column="1" Name="PrefixPathBox" Margin="0,0,8,6" />
                    <Button Grid.Row="6" Grid.Column="2" Content="Browse" Name="PrefixBrowseButton" Click="OnBrowsePrefix" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Extra Wine DLL Overrides" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <TextBox Grid.Row="7" Grid.Column="1" Name="ExtraWineDllOverridesBox" Margin="0,0,8,6" />

                    <CheckBox Grid.Row="8" Grid.Column="1" Content="Enable WINEDEBUG logging" Name="WineDebugCheck"
                              HorizontalAlignment="Left" Margin="0,0,0,6" IsChecked="True" IsCheckedChanged="OnWineDebugToggled" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="WINEDEBUG value" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <TextBox Grid.Row="9" Grid.Column="1" Name="WineDebugBox" Margin="0,0,8,6" />
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header><TextBlock Text="Dalamud" FontSize="14" /></TabItem.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,12,0,0" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

                    <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Content="Enable Dalamud" Name="DalamudCheck"
                              HorizontalAlignment="Left" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Load Method" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Name="LoadMethodCombo" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Dalamud Branch" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Name="BranchCombo" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Injection Delay (ms)" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <TextBox Grid.Row="3" Grid.Column="1" Name="InjectionDelayBox" Margin="0,0,8,6" />

                    <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Content="Manual injection (local injector build)" Name="ManualInjectCheck"
                              HorizontalAlignment="Left" Margin="0,0,0,6" IsCheckedChanged="OnManualInjectToggled" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Manual Inject Path" Name="ManualInjectLabel" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <TextBox Grid.Row="5" Grid.Column="1" Name="ManualInjectPathBox" Margin="0,0,8,6" />
                    <Button Grid.Row="5" Grid.Column="2" Content="Browse" Name="ManualInjectBrowseButton" Click="OnBrowseManualInject" Margin="0,0,0,6" />
                </Grid>
                </ScrollViewer>
            </TabItem>



            <TabItem>
                <TabItem.Header><TextBlock Text="Troubleshooting" FontSize="14" /></TabItem.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,12,0,0">
                    <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Name="FixLdpCheck"
                              Content="Hack: Disable gameoverlayrenderer.so" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="24,0,0,8" TextWrapping="Wrap"
                               Foreground="#808080" Text="May fix black screen on launch (Steam Deck) and some stuttering issues after 40+ minutes." />

                    <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Name="FixXModifiersCheck"
                              Content="Hack: XMODIFIERS=&quot;@im=null&quot;" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="24,0,0,8" TextWrapping="Wrap"
                               Foreground="#808080" Text="Fixes some mouse-related issues, some stuttering issues" />

                    <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Name="FixLibIcuucCheck"
                              Content="Hack: Fix libicuuc Dalamud error" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="24,0,0,8" TextWrapping="Wrap"
                               Foreground="#808080" Text="Fixes a specific &quot;an internal Dalamud error has occurred.&quot; In the terminal you will see this text: &#10;Cannot get symbol u_charsToUChars from libicuuc Error: 127" />

                    <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Name="FixLocaleCheck"
                              Content="Hack: Force locale" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Name="LocaleHackLabel" Margin="24,0,0,8" TextWrapping="Wrap"
                               Foreground="#808080" Text="Sets LC_ALL and LC_CTYPE to the detected UTF-8 locale." />

                    <CheckBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Name="DontUseSystemTzCheck"
                              Content="Hack: Don't use system timezone" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Margin="24,0,0,8" TextWrapping="Wrap"
                               Foreground="#808080" Text="Unsets the TZ environment variable from system provided." />

                    <Grid Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,12,0,0">
                        <Button Grid.Column="0" Name="ClearPrefixButton" Content="Clear Prefix" Click="OnClearPrefix" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Name="ClearLogsButton" Content="Clear Logs" Click="OnClearLogs" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Name="ClearDalamudButton" Content="Clear Dalamud Files" Click="OnClearDalamud" Margin="0,0,8,0" />
                        <Button Grid.Column="3" Name="ClearPluginsButton" Content="Clear Plugins" Click="OnClearPlugins" Margin="0,0,8,0" />
                        <Button Grid.Column="4" Name="ResetSettingsButton" Content="Reset Settings" Click="OnResetSettings" Margin="0,0,8,0" />
                        <Button Grid.Column="5" Name="GenerateTspackButton" Content="Generate TSPack" Click="OnGenerateTspack" />
                    </Grid>
                </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
