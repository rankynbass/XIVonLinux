<Window
    x:Class="XIVonLinux.Launcher.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="760"
    Height="520"
    Title="XIVonLinux">
    <StackPanel Margin="24">
        <TextBlock Text="XIVonLinux" FontSize="28" FontWeight="Bold" />
        <TextBlock Text="Linux-native FFXIV launcher (Proton/umu + in-prefix Windows Dalamud)" Opacity="0.7" Margin="0,6,0,18" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="Fake launch (with Dalamud)" Name="LaunchDalamudButton" Click="OnLaunchDalamud" />
            <Button Content="Fake launch (no Dalamud)" Name="LaunchPlainButton" Click="OnLaunchNoDalamud" />
        </StackPanel>
        <TextBox Name="StatusLog" Margin="0,18,0,0" IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True" Height="300" />
    </StackPanel>
</Window>
